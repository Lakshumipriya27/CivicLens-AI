# ---------------------------------------------------------------
# CivicLens AI - backend configuration
# Copy this file to ".env" (same folder) and edit the values.
# Never commit your real .env file or API keys.
# ---------------------------------------------------------------

# Environment name: development | production
APP_ENV=development

# Secret used to sign login tokens (JWT). Use a long random string.
# If left empty, a random secret is generated once and stored in backend/.dev_secret
SECRET_KEY=

# How long a login token is valid, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (SQLite by default; PostgreSQL example:
# postgresql+psycopg://user:password@localhost:5432/civiclens)
DATABASE_URL=sqlite:///./civiclens.db

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- AI image analysis ----------------
# AI_PROVIDER=demo   -> clearly labelled SIMULATED analysis (local image heuristics, no external AI)
# AI_PROVIDER=gemini -> real image analysis with Google Gemini (requires GEMINI_API_KEY)
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45

# ---------------- Demonstration data ----------------
# Seed clearly fictional demonstration records when the database is empty
SEED_DEMO_DATA=true

# ---------------- Uploads ----------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ---------------- Duplicate detection ----------------
DUP_MAX_DISTANCE_M=200
DUP_TIME_WINDOW_DAYS=30
DUP_MIN_SCORE=0.55

# ---------------- Priority heuristic weights ----------------
# P = W_S*Severity + W_R*Corroboration + W_V*Exposure + W_W*Waiting  (weights should sum to 1)
PRIORITY_WEIGHT_SEVERITY=0.35
PRIORITY_WEIGHT_REPORTS=0.25
PRIORITY_WEIGHT_EXPOSURE=0.20
PRIORITY_WEIGHT_WAITING=0.20
# Days of waiting after which the waiting score reaches 100
PRIORITY_WAITING_FULL_DAYS=30
